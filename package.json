{
  "name": "gridsense-ai",
  "version": "1.0.0",
  "private": true,
  "description": "GridSense AI workspace and development plan download page",
  "scripts": {
    "dev": "pnpm --filter @gridsense/frontend dev",
    "start": "pnpm --filter @gridsense/frontend start",
    "download:dev": "node server.js",
    "frontend:dev": "pnpm --filter @gridsense/frontend dev",
    "frontend:build": "NODE_ENV=production pnpm --filter @gridsense/frontend build",
    "backend:dev": "python3 -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "engines": {
    "node": ">=18"
  }
}
